          <mxGeometry x="175" y="370" width="560" height="40" as="geometry"/>
        </mxCell>

        <!-- Local join annotation -->
        <mxCell id="local_note"
          value="Local join path: mrp_mad_join(is_new) → MRP_EVENT_NEW/JOIN → same deliver_event() path"
