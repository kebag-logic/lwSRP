          vertex="1" parent="1">
          <mxGeometry x="930" y="260" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- join_ind -->
        <mxCell id="join_ind_box" value="join_ind() / leave_ind()&#xa;ops vtable callback&#xa;→ application notified"
          style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;"
