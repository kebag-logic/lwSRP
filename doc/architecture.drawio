          vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="130" height="70" as="geometry"/>
        </mxCell>

        <!-- TalkerAdv flood arrows -->
        <mxCell id="ta_in"
          value="① TalkerAdv IN on port 0"
          style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;fontColor=#6c8ebf;
                 fontSize=9;fontStyle=1;"
          edge="1" source="talker" target="bridge" parent="1">
