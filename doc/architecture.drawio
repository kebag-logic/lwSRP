          vertex="1" parent="1">
          <mxGeometry x="1130" y="130" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- Registrar branch -->
        <mxCell id="reg_sm" value="reg_event()&#xa;Registrar SM&#xa;reg_table lookup"
