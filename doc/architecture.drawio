  <!-- ================================================================
       Page 2 — Rx / Event Data Flow
       ================================================================ -->
  <diagram name="Rx Data Flow" id="rx-flow">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1"
